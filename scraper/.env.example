# Environment variables for the BetFactor scraper service.
# Copy this file to .env and fill in real values before running locally.
# On Fly.io, set these via: fly secrets set KEY=value

# ── Database ─────────────────────────────────────────────────────────────────
# Same Postgres database as the Next.js app (copy from Vercel env vars)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Redis ─────────────────────────────────────────────────────────────────────
# Upstash Redis REST URL (starts with rediss://)
# Get this from https://console.upstash.com → Your database → Details tab
REDIS_URL="rediss://default:password@region.upstash.io:6379"

# ── Scraper tuning ────────────────────────────────────────────────────────────
# How often each bookmaker is scraped, in milliseconds. Default: 90 seconds.
SCRAPE_INTERVAL_MS=90000

# ── Alerts ───────────────────────────────────────────────────────────────────
# Optional: Slack or Telegram webhook URL for failure alerts.
# Leave empty to disable alerts (errors will still appear in logs).
ALERT_WEBHOOK_URL=""
