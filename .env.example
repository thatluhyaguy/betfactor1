# ============================================================
# BetFactor V2 — Environment Variables
# Copy to .env.local for Next.js frontend
# Copy to .env for the scraper service on Railway
# ============================================================

# ----- Database (Prisma) -----
# For local dev: SQLite is pre-configured in prisma/schema.prisma
# For production: Switch to Postgres URL from Railway or Supabase
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/betfactor"

# ----- Redis -----
# Leave blank to use in-memory fallback (local dev without Redis)
# For production: Upstash Redis REST URL or Railway Redis
REDIS_URL=""
# REDIS_URL="redis://default:password@redis-host:6379"

# ----- Scraper settings -----
# Interval between bookmaker scrape cycles (milliseconds)
# Default: 90000 (90 seconds). Don't go below 60000.
SCRAPE_INTERVAL_MS=90000

# ----- Alerts (optional) -----
# Webhook URL for Slack/Telegram failure alerts
# Leave blank to only log to console
ALERT_WEBHOOK_URL=""
